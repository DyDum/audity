<RulesCIS>
  <Rule id="2.1">
    <Name>Ensure unnecessary authentication and authorization modules are disabled (Manual)</Name>
    <Chapter id="2">Configuration</Chapter>
    <Section id="2.1">Modules Configuration</Section>
    <SubSection id="2.1.1">Authentication and Authorization Modules</SubSection>

    <Profiles>
      <Profile level="1" type="Server"/>
    </Profiles>
    <BasePath>/etc/apache2/mods-enabled</BasePath>
    <FileName>*auth*.load</FileName>
    <NonCompliantComment>Unnecessary authentication and authorization modules are enabled.</NonCompliantComment>
    <CorrectiveComment>Disable unused authentication and authorization modules using a2dismod.</CorrectiveComment>
    <Correction><![CDATA[Manual review required; run a2dismod <module_name> for unused auth modules.]]></Correction>
    <Verification><![CDATA[ls /etc/apache2/mods-enabled | grep auth && echo 1 || echo 0]]></Verification>
    <Manual>YES</Manual>
  </Rule>

  <Rule id="2.2">
    <Name>Ensure log_config module is enabled (Automated)</Name>
    <Chapter id="2">Configuration</Chapter>
    <Section id="2.1">Modules Configuration</Section>
    <SubSection id="2.1.2">Logging Module</SubSection>

    <Profiles>
      <Profile level="1" type="Server"/>
    </Profiles>
    <BasePath>/etc/apache2/mods-enabled</BasePath>
    <FileName>log_config.load</FileName>
    <NonCompliantComment>The log configuration module is not enabled, which may lead to misconfigured logging.</NonCompliantComment>
    <CorrectiveComment>Enable the log_config module using a2enmod.</CorrectiveComment>
    <Correction><![CDATA[a2enmod log_config && systemctl reload apache2]]></Correction>
    <Verification><![CDATA[apache2ctl -M | grep -q log_config_module && echo 0 || echo 1]]></Verification>
    <Manual>NO</Manual>
  </Rule>

  <Rule id="2.3">
    <Name>Ensure WebDAV modules are disabled (Automated)</Name>
    <Chapter id="2">Configuration</Chapter>
    <Section id="2.1">Modules Configuration</Section>
    <SubSection id="2.1.3">WebDAV Modules</SubSection>

    <Profiles>
      <Profile level="1" type="Server"/>
    </Profiles>
    <BasePath>/etc/apache2/mods-enabled</BasePath>
    <FileName>dav*.load</FileName>
    <NonCompliantComment>WebDAV modules are enabled, increasing the risk of unauthorized file manipulation.</NonCompliantComment>
    <CorrectiveComment>Disable WebDAV modules using a2dismod.</CorrectiveComment>
    <Correction><![CDATA[a2dismod dav dav_fs && systemctl reload apache2]]></Correction>
    <Verification><![CDATA[apache2ctl -M | grep -E 'dav_module|dav_fs_module' && echo 1 || echo 0]]></Verification>
    <Manual>NO</Manual>
  </Rule>

